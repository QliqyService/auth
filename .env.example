VERIFICATION_TOKEN_SECRET=verification-token-secret
RESET_PASSWORD_TOKEN_SECRET=reset-password-token-secret

GUNICORN_WORKERS_PER_CORE=1.0
GUNICORN_MAX_WORKERS=4
