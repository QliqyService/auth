APP_RELEASE=not-set
APP_STAND=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DOMAIN=auth.localhost
APP_PUBLIC_PATH=/auth
APP_SECRET_KEY=super-secret-key
